# Sao chép file này thành ".env" rồi điền key THẬT của bạn vào (đã thu hồi 3 key cũ và tạo key mới trước khi dùng).
# KHÔNG commit file ".env" lên Git. File .gitignore bên dưới đã chặn sẵn điều này.

ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Cổng server chạy local (đổi nếu bị trùng)
PORT=3000

# Domain frontend được phép gọi vào backend này (CORS). Với local dev để http://localhost:3000
# Khi deploy thật, đổi thành domain thật của bạn, ví dụ: https://veltoz.example.com
ALLOWED_ORIGIN=http://localhost:3000
